      "name": "01. GET all books",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains message and data array', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql('Books retrieved successfully');",
              "    pm.expect(Array.isArray(jsonData.data)).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": ["{{baseUrl}}"],
          "path": ["books", ""]
        },
        "description": "Retrieve all books from the SQLite database.\nExpected Status: 200 OK\nExpected Message: Books retrieved successfully"
      }
    },
