        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"niharika\",\n  \"password\": \"Niharika123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login/",
          "host": ["{{baseUrl}}"],
          "path": ["login", ""]
        },
        "description": "Login with correct credentials. Expected Status: 200 OK, returns jwt_token."
      }
