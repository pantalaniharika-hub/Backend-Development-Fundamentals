  "item": [
    {
      "name": "01. Register User (Success)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response contains success message', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.eql('User registered successfully');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"rahul\",\n  \"name\": \"Rahul Sharma\",\n  \"password\": \"Rahul@2024\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/register/",
          "host": ["{{baseUrl}}"],
          "path": ["register", ""]
        },
        "description": "Registers a new user. Expected Status: 201 Created."
      }
    },
