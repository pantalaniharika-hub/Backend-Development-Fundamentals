  "info": {
    "name": "Lab 4 - Registration and Login JWT",
    "description": "Postman Collection for Aurora University - Lab 4: Registration, Login and JWT\nStudent: Niharika Pantala (Reg No: 252U1R3070 | Section: CSE-DS (2B))\nFaculty: Mr. Yugandhar",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
