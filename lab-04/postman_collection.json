    {
      "name": "07. Login (Success)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains jwt_token', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.jwt_token).to.be.a('string');",
              "    pm.expect(jsonData.jwt_token.length).to.be.above(20);",
              "    pm.globals.set('authToken', jsonData.jwt_token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
